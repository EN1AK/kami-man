+// Only index the grams requested by this planner. Posting lists use profile order;
+// a repeated gram in different segments of one question still counts once.
+function indexRequestedQuestionGrams(profiles, plans) {
+  const postings = new Map();
+  for (const { questions } of plans) {
+    for (const question of questions) {
+      const segments = normalizeCjkQuestionSegments(question);
+      for (const size of [3, 4]) {
+        for (const gram of uniqueCjkNgrams(segments, size)) {
+          if (!postings.has(gram)) postings.set(gram, []);
+        }
+      }
+    }
+  }
+  for (const [index, profile] of profiles.entries()) {
+    for (const segment of profile.cjkSegments) {
+      for (const size of [3, 4]) {
+        for (let offset = 0; offset + size <= segment.length; offset++) {
+          const hits = postings.get(segment.slice(offset, offset + size));
+          if (hits && hits[hits.length - 1] !== index) hits.push(index);
+        }
+      }
+    }
+  }
+  return postings;
+}
+
+function countQueryGramHits(grams, postings, profileCount) {
+  const counts = new Uint32Array(profileCount);
+  for (const gram of grams) {
+    for (const index of postings.get(gram)) counts[index]++;
+  }
+  return counts;
+}

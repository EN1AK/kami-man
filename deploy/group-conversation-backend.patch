@@ -0,0 +1,62 @@
+import json
+from types import SimpleNamespace
+
+import pytest
+from rag_agent import group_chat as group,mention_chat as mention
+from rag_agent.config import Settings
+from rag_agent.sessions import SessionStore
+
+
+def conversation():
+    return [dict(id='m1',speaker='成员1',role='user',text='晚上玩什么'),
+        dict(id='m2',speaker='机器人',role='assistant',text='玩鸣潮',reply_to='m1'),
+        dict(id='m3',speaker='成员2',role='user',text='为什么推荐这个',reply_to='m2')]
+
+
+def payload(**overrides):
+    data=dict(session_id='qq:12345:group:819151070:user:222',group_id=819151070,text='为什么推荐这个',group_conversation=conversation())
+    data.update(overrides);return data
+
+
+def test_random_request_preserves_role_and_quote_chain():
+    request=group.parse_group_chat_request(dict(group_id=819151070,messages=conversation()))
+    assert request.messages==conversation()
+    assert 'speaker=机器人且role=assistant' in group.build_group_prompt(request)
+
+
+@pytest.mark.parametrize('change',[
+    dict(speaker='机器人',role='user'),dict(speaker='成员1',role='assistant'),
+    dict(id='123456789'),dict(reply_to='m9'),dict(reply_to=[]),
+])
+def test_invalid_role_id_and_quote_relationship_rejected(change):
+    rows=conversation();rows[-1].update(change)
+    with pytest.raises(ValueError):group.parse_conversation_messages(rows)
+
+
+def test_window_is_bounded_and_legacy_payloads_remain_valid():
+    rows=[dict(speaker='成员1',text='普通消息') for _ in range(30)]
+    assert len(group.parse_conversation_messages(rows))==30
+    with pytest.raises(ValueError):group.parse_conversation_messages(rows+[rows[0]])
+    assert group.parse_conversation_messages([dict(speaker='成员1',text='你好')])==[dict(speaker='成员1',text='你好')]
+
+
+@pytest.mark.parametrize('overrides',[
+    dict(session_id='qq:12345:private:user:222',group_id=None),
+    dict(session_id='qq:12345:group:123:user:222',group_id=123),
+])
+def test_public_group_context_cannot_enter_private_or_other_groups(overrides):
+    with pytest.raises(ValueError):mention.parse_mention_request(payload(**overrides))
+
+
+def test_mention_receives_bot_reply_without_reading_professional_history(tmp_path,monkeypatch):
+    monkeypatch.setattr(mention,'_casual_store',SessionStore(tmp_path/'casual.db'))
+    monkeypatch.setattr(mention,'load_persona',lambda:'完整群人格')
+    capture=[]
+    def invoke(factory,settings,route,messages,**options):
+        capture.extend(messages)
+        return SimpleNamespace(content=json.dumps(dict(reply='因为战斗比较合你口味')))
+    monkeypatch.setattr(mention,'invoke_group_model',invoke)
+    result=mention.execute_mention(mention.parse_mention_request(payload()),Settings.from_env({}))
+    assert result['route']=='casual'
+    assert json.loads(capture[1]['content'])['group_conversation']==conversation()
+    assert '完整群人格' in capture[0]['content']

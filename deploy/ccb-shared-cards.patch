+_catalog_lock = threading.Lock()
+_catalog_stamp = None
+_catalog_check_after = 0.0
+
+
+def _shared_catalog_stamp():
+    paths = [os.environ.get("CARD_DB_PATH"), os.environ.get("CARD_METADATA_DB"), os.environ.get("CARD_STRINGS_PATH")]
+    return tuple((str(path), (stat := Path(path).stat()).st_mtime_ns, stat.st_size, stat.st_ino)
+                 for path in paths if path)
+
+
+if os.environ.get("CARD_DB_PATH"):
+    _catalog_stamp = _shared_catalog_stamp()
+
+
+@app.before_request
+def refresh_shared_catalog():
+    global db, _catalog_stamp, _catalog_check_after
+    if not os.environ.get("CARD_DB_PATH") or time.monotonic() < _catalog_check_after:
+        return
+    if not _catalog_lock.acquire(blocking=False):
+        return
+    try:
+        _catalog_check_after = time.monotonic() + 10
+        stamp = _shared_catalog_stamp()
+        if stamp != _catalog_stamp:
+            refreshed = load_card_database()
+            db = refreshed
+            _catalog_stamp = stamp
+            app.logger.info("Shared card catalog reloaded: %s unique card names", len(db))
+    except Exception:
+        app.logger.exception("Shared catalog reload failed; keeping the previous catalog")
+    finally:
+        _catalog_lock.release()
+
+

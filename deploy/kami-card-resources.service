[Unit]
Description=Cache new Yu-Gi-Oh card images and simulator card names
Wants=network-online.target kami-cards-update.service
After=network-online.target kami-cards-update.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/qqbot/kami-man
ExecStart=/usr/bin/flock -n /home/ubuntu/qqbot/kami-man/data/ygo_images/.update.lock /home/ubuntu/qqbot/kami-man/venv/bin/python -u scripts/cache_ygo_images.py /home/ubuntu/qqbot/shared-ygo/cards.cdb
TimeoutStartSec=45min
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/qqbot/kami-man/data

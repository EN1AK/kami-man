

# MyCard live replay archive (only ordinary account spectator access)
MYCARD_CAPTURE_ENABLED=false
MYCARD_ARCHIVE_DIR=data/mycard_archive
MYCARD_ARCHIVE_MAX_GB=10
# Optional local YGOPro CDB for explicit alternate-art identities
MYCARD_CARD_DB=/home/ubuntu/qqbot/ygo-rag/data/cards.cdb
MYCARD_CREDENTIALS_FILE=data/mycard_archive/credentials.json
MYCARD_CAPTURE_CONCURRENCY=1
# Optional additional credential files, separated by the OS path separator (: on Linux).
MYCARD_EXTRA_CREDENTIALS_FILES=
MYCARD_RANK_CUTOFF=500
MYCARD_JOIN_INTERVAL=2
MYCARD_SPECTATOR_HOST=tiramisu.moecube.com
MYCARD_SPECTATOR_PORT=8911
MYCARD_SPECTATOR_VERSION=0x1362

# Windows Jihuanshe bridge (via a private SSH reverse tunnel)
JIHUANSHE_BRIDGE_URL=http://127.0.0.1:8791
JIHUANSHE_BRIDGE_TOKEN=replace-with-a-random-bridge-secret
JIHUANSHE_BRIDGE_TIMEOUT=90
